#!/usr/bin/env bash
# staged な変更に含まれるシークレットを betterleaks で検出する
set -euo pipefail

if ! command -v betterleaks >/dev/null 2>&1; then
  echo "betterleaks が見つかりません (mise install を実行してください)" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
exec betterleaks git --pre-commit --staged --redact --no-banner \
  --confidence low \
  --config "$root/.betterleaks.toml" "$root"
